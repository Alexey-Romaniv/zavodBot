# Токен от @BotFather
BOT_TOKEN=

# Необязательное — значения по умолчанию уже подходят
SHIFTBOT_TZ=Europe/Warsaw
SHIFTBOT_CURRENCY=zł
SHIFTBOT_DAY_RATE=33.15
SHIFTBOT_NIGHT_RATE=35.20
SHIFTBOT_SHIFT_HOURS=8
SHIFTBOT_REMIND_HOURS=2
# Через сколько минут после конца смены спрашивать, сколько часов зачли
SHIFTBOT_CONFIRM_AFTER_MIN=15
# 1 — ходить к Telegram только по IPv6 (нужно на VM без внешнего IPv4, например в GCP)
SHIFTBOT_FORCE_IPV6=0
# День и время еженедельного вопроса про смены (cron: mon..sun)
SHIFTBOT_ASK_DOW=sat
SHIFTBOT_ASK_HOUR=18

# Штрафы по договору (нетто): прогул и несообщение о доступности / опоздание и перерыв
SHIFTBOT_PENALTY_ABSENCE=370
SHIFTBOT_PENALTY_LATE=150
# На сколько падает ставка (брутто за час) в месяце без 100% присутствия по графику
SHIFTBOT_RATE_CUT=0.50
# За сколько дней нужно предупреждать об изменении заявленной доступности
SHIFTBOT_NOTICE_DAYS=7

# --- Админка (/admin) ---
# Пароль для входа. Пусто — админка выключена совсем.
SHIFTBOT_ADMIN_PASSWORD=
# Либо вместо открытого пароля положи его sha256 (тогда пароля на сервере нет):
# python -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" мойпароль
SHIFTBOT_ADMIN_PASSWORD_SHA256=
# Кому вообще можно пробовать войти (telegram id через запятую). Пусто — любому с паролем.
SHIFTBOT_ADMIN_IDS=
# Сколько минут живёт вход, попыток пароля подряд и минут блокировки после них
SHIFTBOT_ADMIN_TTL_MIN=60
SHIFTBOT_ADMIN_ATTEMPTS=5
SHIFTBOT_ADMIN_LOCKOUT_MIN=15
